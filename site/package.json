{
  "name": "halkliff-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "predev": "pnpm prepare:pyodide && pnpm prepare:blog",
    "dev": "next dev",
    "prebuild": "pnpm prepare:pyodide && pnpm prepare:blog",
    "build": "next build",
    "start": "next start",
    "prepare:pyodide": "node scripts/prepare-pyodide-assets.mjs",
    "prepare:blog": "node scripts/prepare-blog-manifest.mjs",
    "spike:rust": "node scripts/rust-browser-compiler-spike.mjs",
    "test": "pnpm test:unit && pnpm test:runtime && pnpm test:adapters",
    "test:unit": "vitest run",
    "test:runtime": "node --experimental-strip-types --test tests/notebook-runtime.test.ts",
    "test:adapters": "node --experimental-strip-types --test tests/code-notebook-adapters.test.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/pyodide --ignore-pattern public/python-notebook.worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "pyodide": "314.0.3",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "type": "module"
}
